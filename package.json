{
  "name": "vanitaapplebee.cordova.tm470mathsapp",
  "displayName": "TM470MathsApp",
  "version": "1.0.0",
  "description": "Mathematics learning app for 5 year old children, built using Apache Cordova.",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:vendor": "node tools/vendor-dexie.mjs --check",
    "vendor:dexie": "node tools/vendor-dexie.mjs"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Vanita Applebee",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "cordova-android": "^9.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-ios": "^6.3.0",
    "cordova-plugin-file": "^6.0.2",
    "cordova-plugin-file-opener2": "^3.0.5",
    "cordova-plugin-file-transfer": "^1.7.1",
    "cordova-plugin-whitelist": "^1.3.4"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-file": {},
      "cordova-plugin-file-transfer": {},
      "cordova-plugin-file-opener2": {
        "ANDROID_SUPPORT_V4_VERSION": "27.+"
      }
    },
    "platforms": [
      "android",
      "ios",
      "browser"
    ]
  },
  "dependencies": {
    "dexie": "3.2.7"
  }
}